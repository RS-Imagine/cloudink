{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudink-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "OWNER_EMAIL": "owner@example.com",
    "SITE_URL": "https://blog.example.com",
    "IMAGE_ORIGIN": "https://images.example.com",
    "SITE_WORKER_NAME": "cloudink",
    "PRODUCTION_BRANCH": "main",
    "FOOTER_TEXT": "",
    "CLARITY_ID": ""
  },
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "cloudink-content"
    },
    {
      "binding": "IMAGES",
      "bucket_name": "cloudink-images"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
