{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "r-blog",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "forimagine.eu.org", "custom_domain": true },
    { "pattern": "www.forimagine.eu.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "build-work/public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
