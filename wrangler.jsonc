{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudink",
  "main": "cloud-web/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "secrets": { "required": ["SETUP_TOKEN"] },
  "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "cloudink-storage" }],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
  ],
  "observability": { "enabled": true },
  "assets": {
    "directory": "build-work/web-public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
